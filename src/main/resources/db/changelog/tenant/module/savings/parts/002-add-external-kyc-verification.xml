<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">  

    <changeSet author="fineract" id="ss-002-1">
        <preConditions onFail="MARK_RAN">
            <and>
                <not><tableExists tableName="m_client_kyc_verification"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_verification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_verification"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_verification_client" referencedTableName="m_client" referencedColumnNames="id"/>
            </column>
            <column name="session_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="workflow_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="workflow_version" type="INTEGER"/>
            <column name="webhook_type" type="VARCHAR(100)"/>
            <column name="kyc_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="kyc_timestamp" type="BIGINT"/>
            <column name="kyc_created_at" type="BIGINT"/>
            <column name="metadata_text" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_verification_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_verification_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="m_client_kyc_verification" indexName="uk_kyc_verification_session" unique="true">
            <column name="session_id"/>
        </createIndex>
        <createIndex tableName="m_client_kyc_verification" indexName="idx_kyc_verification_client">
            <column name="client_id"/>
        </createIndex>
        <createIndex tableName="m_client_kyc_verification" indexName="idx_kyc_verification_status">
            <column name="kyc_status"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-002-2">
        <preConditions onFail="MARK_RAN">
            <and>
                <not><tableExists tableName="m_client_kyc_decision"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_decision">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_decision"/>
            </column>
            <column name="kyc_verification_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_kyc_decision_verification" foreignKeyName="fk_kyc_decision_verification" referencedTableName="m_client_kyc_verification" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="decision_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="decision_workflow_id" type="VARCHAR(255)"/>
            <column name="decision_created_at" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_decision_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_decision_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="fineract" id="ss-002-3">
        <preConditions onFail="MARK_RAN">
            <and>                
                <not><tableExists tableName="m_client_kyc_decision_feature"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_decision_feature">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_decision_feature"/>
            </column>
            <column name="kyc_decision_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_feature_decision" referencedTableName="m_client_kyc_decision" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="feature_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_feature_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_feature_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_client_kyc_decision_feature" indexName="idx_kyc_feature_decision">
            <column name="kyc_decision_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-002-4">
        <preConditions onFail="MARK_RAN">
            <and>                
                <not><tableExists tableName="m_client_kyc_face_match"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_face_match">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_face_match"/>
            </column>
            <column name="kyc_decision_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_face_match_decision" referencedTableName="m_client_kyc_decision" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="node_id" type="VARCHAR(255)"/>
            <column name="match_score" type="DECIMAL(5,2)"/>
            <column name="match_status" type="VARCHAR(50)"/>
            <column name="source_image_url" type="TEXT"/>
            <column name="target_image_url" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_face_match_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_face_match_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_client_kyc_face_match" indexName="idx_kyc_face_match_decision">
            <column name="kyc_decision_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-002-5">
        <preConditions onFail="MARK_RAN">
            <and>                
                <not><tableExists tableName="m_client_kyc_id_verification"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_id_verification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_id_verification"/>
            </column>
            <column name="kyc_decision_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_id_verification_decision" referencedTableName="m_client_kyc_decision" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="node_id" type="VARCHAR(255)"/>
            <column name="verification_status" type="VARCHAR(50)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="full_name" type="VARCHAR(500)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="gender" type="VARCHAR(10)"/>
            <column name="age" type="INTEGER"/>
            <column name="nationality" type="VARCHAR(255)"/>
            <column name="document_number" type="VARCHAR(255)"/>
            <column name="document_type" type="VARCHAR(255)"/>
            <column name="issuing_state" type="VARCHAR(50)"/>
            <column name="issuing_state_name" type="VARCHAR(255)"/>
            <column name="personal_number" type="VARCHAR(255)"/>
            <column name="expiration_date" type="DATE"/>
            <column name="formatted_address" type="TEXT"/>
            <column name="parsed_address" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_id_verification_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_id_verification_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_client_kyc_id_verification" indexName="idx_kyc_id_verification_decision">
            <column name="kyc_decision_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-002-6">
        <preConditions onFail="MARK_RAN">
            <and>
                <not><tableExists tableName="m_client_kyc_aml_screening"/></not>                
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_aml_screening">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_aml_screening"/>
            </column>
            <column name="kyc_decision_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_screening_decision" referencedTableName="m_client_kyc_decision" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="node_id" type="VARCHAR(255)"/>
            <column name="screening_status" type="VARCHAR(50)"/>
            <column name="total_hits" type="INTEGER" defaultValueNumeric="0"/>
            <column name="screened_nationality" type="VARCHAR(50)"/>
            <column name="screened_full_name" type="VARCHAR(500)"/>
            <column name="screened_document_number" type="VARCHAR(255)"/>
            <column name="screened_date_of_birth" type="DATE"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_screening_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_screening_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_client_kyc_aml_screening" indexName="idx_kyc_aml_screening_decision">
            <column name="kyc_decision_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-002-7">
        <preConditions onFail="MARK_RAN">
            <and>                
                <not><tableExists tableName="m_client_kyc_aml_hit"/></not>
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_aml_hit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_aml_hit"/>
            </column>
            <column name="aml_screening_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_hit_screening" referencedTableName="m_client_kyc_aml_screening" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="hit_data" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_hit_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_aml_hit_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_client_kyc_aml_hit" indexName="idx_kyc_aml_hit_screening">
            <column name="aml_screening_id"/>
        </createIndex>
    </changeSet>
    
    <changeSet author="fineract" id="ss-002-8">
        <preConditions onFail="MARK_RAN">
            <and>                
                <not><tableExists tableName="m_client_kyc_feature_status"/></not>
                <tableExists tableName="m_client"/>
                <tableExists tableName="m_appuser"/>
            </and>
        </preConditions>
        <createTable tableName="m_client_kyc_feature_status">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_m_client_kyc_feature_status"/>
            </column>
            <column name="kyc_verification_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_kyc_feature_status_verification" foreignKeyName="fk_kyc_feature_status_verification" referencedTableName="m_client_kyc_verification" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="face_matches" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="id_verifications" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="aml_screenings" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="decision" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_feature_status_created_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_kyc_feature_status_last_modified_by" referencedTableName="m_appuser" referencedColumnNames="id"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>