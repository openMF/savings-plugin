<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="ss-057-bt-returned-check-1">
        <validCheckSum>9:9e0efde96134086492a4841b3bc09cb3</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_base_teller_returned_check"/>
            </not>
        </preConditions>
        <createTable tableName="m_base_teller_returned_check">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deposit_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="deposit_check_detail_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="savings_account_id" type="bigint"/>
            <column name="check_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="check_bank" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="check_number" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="decimal(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="office_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="teller_id" type="bigint"/>
            <column name="cashier_id" type="bigint"/>
            <column name="returned_on_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="return_reason" type="varchar(500)"/>
            <column name="status" type="varchar(30)" defaultValue="RETURNED">
                <constraints nullable="false"/>
            </column>
            <column name="cashier_transaction_id" type="bigint"/>
            <column name="settled_by" type="bigint"/>
            <column name="settled_on_utc" type="TIMESTAMP"/>
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_base_teller_returned_check"
                             columnNames="deposit_check_detail_id"
                             constraintName="uk_bt_returned_check_detail"/>
        <createIndex indexName="idx_bt_returned_check_search"
                     tableName="m_base_teller_returned_check">
            <column name="office_id"/>
            <column name="returned_on_date"/>
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_bt_returned_check_client"
                     tableName="m_base_teller_returned_check">
            <column name="client_id"/>
        </createIndex>
        <createIndex indexName="idx_bt_returned_check_teller"
                     tableName="m_base_teller_returned_check">
            <column name="teller_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-057-bt-returned-check-2">
        <validCheckSum>9:7ab0e3d481fec0e6848e348989681aaf</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_base_teller_returned_check_payment"/>
            </not>
        </preConditions>
        <createTable tableName="m_base_teller_returned_check_payment">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="idempotency_key" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="request_fingerprint" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="receipt_number" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="returned_check_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="cash_received" type="decimal(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="change_amount" type="decimal(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_type_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="failure_message" type="varchar(1000)"/>
            <column name="operator_id" type="bigint"/>
            <column name="office_id" type="bigint"/>
            <column name="teller_id" type="bigint"/>
            <column name="cashier_id" type="bigint"/>
            <column name="cashier_transaction_id" type="bigint"/>
            <column name="note" type="varchar(500)"/>
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_on_utc" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="m_base_teller_returned_check_payment"
                             columnNames="idempotency_key"
                             constraintName="uk_bt_rc_payment_idempotency"/>
        <addUniqueConstraint tableName="m_base_teller_returned_check_payment"
                             columnNames="receipt_number"
                             constraintName="uk_bt_rc_payment_receipt"/>
        <addUniqueConstraint tableName="m_base_teller_returned_check_payment"
                             columnNames="returned_check_id"
                             constraintName="uk_bt_rc_payment_returned_check"/>
    </changeSet>

    <changeSet author="fineract" id="ss-057-bt-returned-check-3">
        <validCheckSum>9:0c65ddb68f19c932a96ddd78f2d112bb</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_base_teller_returned_check_payment_cash_detail"/>
            </not>
        </preConditions>
        <createTable tableName="m_base_teller_returned_check_payment_cash_detail">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="settlement_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="denomination_identifier" type="varchar(100)"/>
            <column name="denomination_value" type="decimal(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_bt_rc_payment_cash_detail"
                     tableName="m_base_teller_returned_check_payment_cash_detail">
            <column name="settlement_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="ss-057-bt-returned-check-4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission
                WHERE code = 'CREATE_BASE_TELLER_RETURNED_CHECK_PAYMENT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_BASE_TELLER_RETURNED_CHECK_PAYMENT"/>
            <column name="entity_name" value="BASE_TELLER_RETURNED_CHECK_PAYMENT"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="READ_BASE_TELLER_RETURNED_CHECK_PAYMENT"/>
            <column name="entity_name" value="BASE_TELLER_RETURNED_CHECK_PAYMENT"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
