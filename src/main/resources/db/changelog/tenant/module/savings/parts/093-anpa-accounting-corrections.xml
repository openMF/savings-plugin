<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
  <!-- Append-only policy/proposal/evidence events. No native balances, journals or mappings change. -->
  <changeSet author="fineract" id="ss-093-anpa-accounting-controls">
    <createTable tableName="m_anpa_control_record">
      <column name="sequence_no" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
      <column name="id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="tenant_identifier" type="VARCHAR(100)"><constraints nullable="false"/></column>
      <column name="kind" type="VARCHAR(32)"><constraints nullable="false"/></column>
      <column name="loan_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="product_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="office_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="actor_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="business_date" type="DATE"><constraints nullable="false"/></column>
      <column name="recorded_at" type="TIMESTAMP"><constraints nullable="false"/></column>
      <column name="idempotency_key" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="request_hash" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="parent_id" type="VARCHAR(36)"><constraints nullable="true"/></column>
      <column name="policy_version" type="INT"><constraints nullable="true"/></column>
      <column name="approval_for" type="VARCHAR(36)"><constraints nullable="true"/></column>
      <column name="supersedes_id" type="VARCHAR(36)"><constraints nullable="true"/></column>
      <column name="source_fingerprint" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="request_json" type="TEXT"><constraints nullable="false"/></column>
      <column name="result_json" type="TEXT"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="id" constraintName="uq_anpa_control_id"/>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="tenant_identifier,id" constraintName="uq_anpa_control_tenant_id"/>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="tenant_identifier,idempotency_key" constraintName="uq_anpa_control_request"/>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="tenant_identifier,product_id,office_id,policy_version" constraintName="uq_anpa_control_policy_version"/>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="tenant_identifier,approval_for" constraintName="uq_anpa_control_approval"/>
    <addUniqueConstraint tableName="m_anpa_control_record" columnNames="tenant_identifier,supersedes_id" constraintName="uq_anpa_control_successor"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="tenant_identifier,parent_id" referencedTableName="m_anpa_control_record" referencedColumnNames="tenant_identifier,id" constraintName="fk_anpa_control_parent"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="tenant_identifier,approval_for" referencedTableName="m_anpa_control_record" referencedColumnNames="tenant_identifier,id" constraintName="fk_anpa_control_approval"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="tenant_identifier,supersedes_id" referencedTableName="m_anpa_control_record" referencedColumnNames="tenant_identifier,id" constraintName="fk_anpa_control_previous"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="loan_id" referencedTableName="m_loan" referencedColumnNames="id" constraintName="fk_anpa_control_loan_id"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="product_id" referencedTableName="m_product_loan" referencedColumnNames="id" constraintName="fk_anpa_control_product_id"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="office_id" referencedTableName="m_office" referencedColumnNames="id" constraintName="fk_anpa_control_office_id"/>
    <addForeignKeyConstraint baseTableName="m_anpa_control_record" baseColumnNames="actor_id" referencedTableName="m_appuser" referencedColumnNames="id" constraintName="fk_anpa_control_actor_id"/>
    <createIndex tableName="m_anpa_control_record" indexName="idx_anpa_control_history"><column name="tenant_identifier"/><column name="loan_id"/><column name="kind"/><column name="sequence_no"/></createIndex>
    <sql>ALTER TABLE m_anpa_control_record ADD CONSTRAINT ck_anpa_control_kind CHECK (
      kind IN ('POLICY_DRAFT','POLICY_APPROVAL','RECONCILIATION','ADJUSTMENT_PROPOSAL')
      AND ((kind='POLICY_DRAFT' AND policy_version IS NOT NULL AND policy_version &gt; 0) OR (kind &lt;&gt; 'POLICY_DRAFT' AND policy_version IS NULL))
      AND ((kind='POLICY_APPROVAL' AND approval_for IS NOT NULL AND parent_id IS NOT NULL AND parent_id=approval_for) OR (kind &lt;&gt; 'POLICY_APPROVAL' AND approval_for IS NULL))
      AND (parent_id IS NULL OR parent_id &lt;&gt; id)
      AND (supersedes_id IS NULL OR (supersedes_id &lt;&gt; id AND kind IN ('RECONCILIATION','ADJUSTMENT_PROPOSAL'))));</sql>
    <insert tableName="m_permission"><column name="grouping" value="loan"/><column name="code" value="READ_ANPA_RECONCILIATION"/><column name="entity_name" value="ANPA_RECONCILIATION"/><column name="action_name" value="READ"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    <insert tableName="m_permission"><column name="grouping" value="loan"/><column name="code" value="MANAGE_ANPA_ACCOUNTING_POLICY"/><column name="entity_name" value="ANPA_ACCOUNTING_POLICY"/><column name="action_name" value="MANAGE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    <insert tableName="m_permission"><column name="grouping" value="loan"/><column name="code" value="APPROVE_ANPA_ACCOUNTING_POLICY"/><column name="entity_name" value="ANPA_ACCOUNTING_POLICY"/><column name="action_name" value="APPROVE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
    <insert tableName="m_permission"><column name="grouping" value="loan"/><column name="code" value="CREATE_ANPA_ADJUSTMENT_PROPOSAL"/><column name="entity_name" value="ANPA_ADJUSTMENT_PROPOSAL"/><column name="action_name" value="CREATE"/><column name="can_maker_checker" valueBoolean="false"/></insert>
  </changeSet>
  <changeSet author="fineract" id="ss-093-anpa-immutable-postgresql" dbms="postgresql">
    <sql splitStatements="false"><![CDATA[
      CREATE FUNCTION anpa_control_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
      BEGIN RAISE EXCEPTION 'ANPA control records are immutable; append a successor' USING ERRCODE = '55000'; END;
      $$;
    ]]></sql>
    <sql>CREATE TRIGGER anpa_control_immutable BEFORE UPDATE OR DELETE ON m_anpa_control_record FOR EACH ROW EXECUTE FUNCTION anpa_control_immutable();</sql>
  </changeSet>
  <changeSet author="fineract" id="ss-093-anpa-immutable-mysql" dbms="mysql,mariadb">
    <sql splitStatements="false">CREATE TRIGGER anpa_control_no_update BEFORE UPDATE ON m_anpa_control_record FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ANPA control records are immutable';</sql>
    <sql splitStatements="false">CREATE TRIGGER anpa_control_no_delete BEFORE DELETE ON m_anpa_control_record FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ANPA control records are immutable';</sql>
  </changeSet>
</databaseChangeLog>
