<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">    
    <!-- ============================================================
         TABLE: m_client_kyc_feature_status
         Top-level KYC session received from the external webhook.
         ============================================================ -->
    <changeSet author="fineract" id="ss-003-1">
        <!-- Preconditions: ensure parent tables exist and this table does not already exist -->
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_client_kyc_feature_status"/>
            </and>
        </preConditions>
        <sql>
            ALTER TABLE m_client_kyc_feature_status
                ADD COLUMN IF NOT EXISTS kyc_status VARCHAR(50) NOT NULL DEFAULT 'In Review';
        </sql>
    </changeSet>

</databaseChangeLog>
