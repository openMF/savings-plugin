<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Insert READ_TRANSFER_FEE permission -->
    <changeSet author="fineract" id="ss-040-1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission WHERE code = 'READ_TRANSFER_FEE'
            </sqlCheck>
        </preConditions>
        <comment>Insert READ_TRANSFER_FEE permission</comment>
        <insert tableName="m_permission">
            <column name="grouping" value="self_service"/>
            <column name="code" value="READ_TRANSFER_FEE"/>
            <column name="entity_name" value="TRANSFER_FEE"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

