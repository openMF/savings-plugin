    <!-- Assign all TRANSFER_FEE permissions to Super User role -->
    <changeSet author="fineract" id="ss-040-5">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_role_permission rp
                INNER JOIN m_role r ON rp.role_id = r.id
                INNER JOIN m_permission p ON rp.permission_id = p.id
                WHERE r.name = 'Super user' AND p.code = 'READ_TRANSFER_FEE'
            </sqlCheck>
        </preConditions>
        <comment>Assign TRANSFER_FEE permissions to Super User role</comment>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT r.id, p.id
            FROM m_role r, m_permission p
            WHERE r.name = 'Super user'
            AND p.code IN ('READ_TRANSFER_FEE', 'CREATE_TRANSFER_FEE', 'UPDATE_TRANSFER_FEE', 'DELETE_TRANSFER_FEE')
            AND NOT EXISTS (
                SELECT 1 FROM m_role_permission rp
                WHERE rp.role_id = r.id AND rp.permission_id = p.id
            );
        </sql>
    </changeSet>

    <!-- Assign READ_TRANSFER_FEE permission to Self Service User role -->
